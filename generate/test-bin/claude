#!/bin/sh
# A stand-in for `claude -p` in tests: one successful result, the text of $FAKE_CLAUDE_REPLY (a file) or "from claude".
cat >/dev/null
node -e 'const fs = require("fs"), f = process.env.FAKE_CLAUDE_REPLY;
console.log(JSON.stringify({ type: "result", subtype: "success", is_error: false, result: f ? fs.readFileSync(f, "utf8") : "from claude", total_cost_usd: 0.01 }))'
